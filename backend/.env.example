PORT=4000
# Local development allows localhost/127.0.0.1 on Vite ports 5173 and 5174.
# For production, set NODE_ENV=production and list only trusted HTTPS origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
DATABASE_URL="file:./dev.db"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@relive.local
ADMIN_NAME=reLIVE Admin
ADMIN_PASSWORD=
# Optional pre-hashed alternative; takes precedence over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  name                  String
  passwordHash          String
  phone                 String              @default("")
  profileImage          String?
  state                 String              @default("")
  city                  String              @default("")
  averageRating         Float               @default(0)
  totalReviews          Int                 @default(0)
  reports               Report[]
  completedTransactions Int                 @default(0)
  role                  String              @default("USER")
  tokenVersion          Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  listings              Listing[]
  favourites            Favourite[]
  offersMade            Offer[]             @relation("OfferBuyer")
  offersReceived        Offer[]             @relation("OfferSeller")
  offerHistory          OfferHistory[]
  walletBalance         Int                 @default(0)
  walletTransactions    WalletTransaction[]
  purchases             Purchase[]          @relation("PurchaseBuyer")
  sales                 Purchase[]          @relation("PurchaseSeller")
  buyingTransactions    Transaction[]       @relation("TransactionBuyer")
  sellingTransactions   Transaction[]       @relation("TransactionSeller")
  reviewsWritten        Review[]            @relation("ReviewAuthor")
  reviewsReceived       Review[]            @relation("ReviewRecipient")
  notifications         Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model Listing {
  id                       String         @id @default(cuid())
  sellerId                 String
  seller                   User           @relation(fields: [sellerId], references: [id])
  title                    String
  description              String
  // Integer sen; API accepts and returns RM with two decimal places.
  price                    Int
  category                 String
  condition                String
  state                    String
  city                     String
  status                   String         @default("ACTIVE")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  images                   ListingImage[]
  favourites               Favourite[]
  offers                   Offer[]
  purchase                 Purchase?
  transaction              Transaction?
  moderationReason         String?
  moderationPreviousStatus String?
  reports                  Report[]

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}

model Report {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id])
  reporterId  String
  reporter    User      @relation(fields: [reporterId], references: [id])
  reason      String
  description String?
  status      String    @default("PENDING")
  adminReason String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  version     Int       @default(0)

  @@index([status, createdAt])
  @@index([listingId])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  position  Int

  @@index([listingId, position])
}

model Favourite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model Offer {
  id            String         @id @default(cuid())
  listingId     String
  listing       Listing        @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User           @relation("OfferBuyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User           @relation("OfferSeller", fields: [sellerId], references: [id])
  // All prices are stored in sen and returned as RM by the API.
  originalPrice Int
  currentAmount Int
  agreedPrice   Int?
  status        String         @default("PENDING")
  nextActorId   String?
  closeReason   String?
  version       Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  history       OfferHistory[]
  purchase      Purchase?

  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([listingId, status])
}

model OfferHistory {
  id        Int      @id @default(autoincrement())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  action    String
  createdAt DateTime @default(now())

  @@index([offerId, id])
}

model WalletTransaction {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String
  // Positive amounts in sen. PURCHASE is a debit; TOP_UP and SALE are credits.
  amount     Int
  method     String
  status     String    @default("PENDING")
  reference  String
  requestKey String?
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([userId, requestKey])
  @@unique([userId, reference])
  @@index([userId, createdAt])
}

model Purchase {
  id                 String              @id @default(cuid())
  listingId          String              @unique
  listing            Listing             @relation(fields: [listingId], references: [id])
  buyerId            String
  buyer              User                @relation("PurchaseBuyer", fields: [buyerId], references: [id])
  sellerId           String
  seller             User                @relation("PurchaseSeller", fields: [sellerId], references: [id])
  offerId            String?             @unique
  offer              Offer?              @relation(fields: [offerId], references: [id])
  listingTitle       String
  amount             Int
  method             String              @default("WALLET")
  status             String              @default("SUCCESS")
  reference          String              @unique
  requestKey         String
  createdAt          DateTime            @default(now())
  walletTransactions WalletTransaction[]
  transaction        Transaction?

  @@unique([buyerId, requestKey])
  @@index([sellerId, createdAt])
}

model Transaction {
  id            String   @id @default(cuid())
  purchaseId    String   @unique
  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  listingId     String   @unique
  listing       Listing  @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User     @relation("TransactionBuyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User     @relation("TransactionSeller", fields: [sellerId], references: [id])
  // Price snapshots in sen; the API returns RM.
  originalPrice Int
  finalPrice    Int
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
  reviews       Review[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model Review {
  id             String      @id @default(cuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id])
  reviewerId     String
  reviewer       User        @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewedUserId String
  reviewedUser   User        @relation("ReviewRecipient", fields: [reviewedUserId], references: [id])
  rating         Int
  comment        String?
  createdAt      DateTime    @default(now())

  @@unique([transactionId, reviewerId])
  @@index([reviewedUserId, createdAt])
}

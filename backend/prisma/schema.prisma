generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  name                  String
  passwordHash          String
  phone                 String              @default("")
  profileImage          String?
  state                 String              @default("")
  city                  String              @default("")
  averageRating         Float               @default(0)
  completedTransactions Int                 @default(0)
  role                  String              @default("USER")
  tokenVersion          Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  listings              Listing[]
  favourites            Favourite[]
  offersMade            Offer[]             @relation("OfferBuyer")
  offersReceived        Offer[]             @relation("OfferSeller")
  offerHistory          OfferHistory[]
  walletBalance         Int                 @default(0)
  walletTransactions    WalletTransaction[]
  purchases             Purchase[]          @relation("PurchaseBuyer")
  sales                 Purchase[]          @relation("PurchaseSeller")
}

model Listing {
  id          String         @id @default(cuid())
  sellerId    String
  seller      User           @relation(fields: [sellerId], references: [id])
  title       String
  description String
  // Integer sen; API accepts and returns RM with two decimal places.
  price       Int
  category    String
  condition   String
  state       String
  city        String
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ListingImage[]
  favourites  Favourite[]
  offers      Offer[]
  purchase    Purchase?

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  position  Int

  @@index([listingId, position])
}

model Favourite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model Offer {
  id            String         @id @default(cuid())
  listingId     String
  listing       Listing        @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User           @relation("OfferBuyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User           @relation("OfferSeller", fields: [sellerId], references: [id])
  // All prices are stored in sen and returned as RM by the API.
  originalPrice Int
  currentAmount Int
  agreedPrice   Int?
  status        String         @default("PENDING")
  nextActorId   String?
  closeReason   String?
  version       Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  history       OfferHistory[]
  purchase      Purchase?

  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([listingId, status])
}

model OfferHistory {
  id        Int      @id @default(autoincrement())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  action    String
  createdAt DateTime @default(now())

  @@index([offerId, id])
}

model WalletTransaction {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String
  // Positive amounts in sen. PURCHASE is a debit; TOP_UP and SALE are credits.
  amount     Int
  method     String
  status     String    @default("PENDING")
  reference  String
  requestKey String?
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([userId, requestKey])
  @@unique([userId, reference])
  @@index([userId, createdAt])
}

model Purchase {
  id                 String              @id @default(cuid())
  listingId          String              @unique
  listing            Listing             @relation(fields: [listingId], references: [id])
  buyerId            String
  buyer              User                @relation("PurchaseBuyer", fields: [buyerId], references: [id])
  sellerId           String
  seller             User                @relation("PurchaseSeller", fields: [sellerId], references: [id])
  offerId            String?             @unique
  offer              Offer?              @relation(fields: [offerId], references: [id])
  listingTitle       String
  amount             Int
  method             String              @default("WALLET")
  status             String              @default("SUCCESS")
  reference          String              @unique
  requestKey         String
  createdAt          DateTime            @default(now())
  walletTransactions WalletTransaction[]

  @@unique([buyerId, requestKey])
  @@index([sellerId, createdAt])
}

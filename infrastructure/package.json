{
  "name": "relive-aws-setup",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node check.js",
    "setup:database": "node setup-database.js",
    "demo:create": "node demo-listing.js create",
    "demo:read": "node demo-listing.js read",
    "demo:query": "node demo-listing.js query",
    "demo:update": "node demo-listing.js update",
    "demo:delete": "node demo-listing.js delete",
    "db:migrate": "node migrate.js up",
    "db:status": "node migrate.js status",
    "db:unlock": "node migrate.js unlock",
